<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Baselines\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Legacy.Maliev.DocumentService.Api\Legacy.Maliev.DocumentService.Api.csproj" />
    <ProjectReference Include="..\Legacy.Maliev.DocumentService.Application\Legacy.Maliev.DocumentService.Application.csproj" />
    <ProjectReference Include="..\Legacy.Maliev.DocumentService.Domain\Legacy.Maliev.DocumentService.Domain.csproj" />
    <ProjectReference Include="..\Legacy.Maliev.DocumentService.Rendering\Legacy.Maliev.DocumentService.Rendering.csproj" />
  </ItemGroup>
  <!-- Opt-in Document-owned evidence only; no production/shared-runner or coverage-setting change. -->
  <PropertyGroup>
    <DocumentProvenanceCapture Condition="'$(DocumentProvenanceCapture)' == '' and '$(GITHUB_EVENT_NAME)' == 'pull_request' and '$(GITHUB_REPOSITORY)' == 'MALIEV-Co-Ltd/Legacy.Maliev.DocumentService'">true</DocumentProvenanceCapture>
    <DocumentProvenanceCapture Condition="'$(DocumentProvenanceCapture)' == ''">false</DocumentProvenanceCapture>
  </PropertyGroup>
  <Target Name="CaptureDocumentPreTestEvidence" BeforeTargets="VSTest" Condition="'$(DocumentProvenanceCapture)' == 'true' and '$(TargetFramework)' == 'net10.0'">
    <PropertyGroup>
      <DocumentEvidenceOutput>$(MSBuildProjectDirectory)/../runner-results/document-provenance</DocumentEvidenceOutput>
      <DocumentPrivateDiagnostics>$(RUNNER_TEMP)/document-provenance-$(MSBuildProjectName)-$(GITHUB_RUN_ID)-$(GITHUB_RUN_ATTEMPT)</DocumentPrivateDiagnostics>
      <VSTestDiag>$(DocumentPrivateDiagnostics)/vstest.log</VSTestDiag>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Evidence/Capture-DocumentCollectorProvenance.ps1&quot; -Phase PreTest -RepositoryRoot &quot;$(MSBuildProjectDirectory)/..&quot; -TestOutputDirectory &quot;$(TargetDir)&quot; -AssetsPath &quot;$(ProjectAssetsFile)&quot; -OutputRoot &quot;$(DocumentEvidenceOutput)&quot; -PrivateDiagnosticDirectory &quot;$(DocumentPrivateDiagnostics)&quot; -CollectorRequest &quot;$(VSTestCollect)&quot;" />
  </Target>
  <Target Name="CaptureDocumentPostTestEvidence" AfterTargets="VSTest" Condition="'$(DocumentProvenanceCapture)' == 'true' and '$(TargetFramework)' == 'net10.0'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Evidence/Capture-DocumentCollectorProvenance.ps1&quot; -Phase PostTest -RepositoryRoot &quot;$(MSBuildProjectDirectory)/..&quot; -TestOutputDirectory &quot;$(TargetDir)&quot; -AssetsPath &quot;$(ProjectAssetsFile)&quot; -OutputRoot &quot;$(DocumentEvidenceOutput)&quot; -PrivateDiagnosticDirectory &quot;$(DocumentPrivateDiagnostics)&quot; -CollectorRequest &quot;$(VSTestCollect)&quot;" />
  </Target>
</Project>
